DATABASE_PATH=data/permit_leads.sqlite3
CSV_PATH=qualified_leads.csv
ADMIN_API_KEY=replace-with-a-long-random-value

# Manual triggering works without the scheduler. Enable this for one daily run.
SCHEDULER_ENABLED=false
